{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "taskflow",
  "main": "worker.js",
  "compatibility_date": "2026-11-16",
  "previews": {},
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "BOARD",
        "class_name": "Board"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Board"
      ]
    }
  ],
  "build": {
    "command": "python3 scripts/build.py"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
